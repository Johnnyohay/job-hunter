{
  "name": "job-agent",
  "version": "0.1.0",
  "description": "Job application agent: finds roles that fit my CV and preferences daily, drafts tailored materials, tracks everything in Google Sheets, and helps submit applications. Runs on Claude Code; no API keys.",
  "scripts": {
    "fetch": "sh scripts/node.sh src/fetch.ts",
    "record": "sh scripts/node.sh src/record.ts",
    "apply": "sh scripts/node.sh src/apply.ts",
    "check": "sh scripts/node.sh src/check.ts",
    "bridge": "sh scripts/node.sh src/bridge-setup.ts",
    "schedule": "bash scripts/schedule.sh",
    "typecheck": "tsc --noEmit",
    "bridge:deploy": "bash scripts/deploy-bridge.sh",
    "tracker:format": "sh scripts/node.sh src/format-tracker.ts"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
